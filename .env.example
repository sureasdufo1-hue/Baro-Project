APP_ENV=development
DATABASE_URL=postgresql+psycopg://claimlens:claimlens_dev@localhost:5432/claimlens
POLICY_DATABASE_URL=postgresql+psycopg://dbins_policy:dbins_policy_dev@localhost:5433/dbins_policy
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-this-development-secret-to-at-least-32-characters
SESSION_COOKIE_NAME=claimlens_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3004
LOG_LEVEL=INFO
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
OBJECT_STORAGE_PROVIDER=LOCAL_PRIVATE
LOCAL_OBJECT_STORAGE_ROOT=.storage/private
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_DOCUMENT_FILE_SIZE_MB=15
MAX_DOCUMENTS_PER_CLAIM=20
MAX_TOTAL_DOCUMENT_SIZE_PER_CLAIM_MB=100
SIGNED_URL_EXPIRATION_SECONDS=300
MALWARE_SCANNER_PROVIDER=DEVELOPMENT
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
OCR_PROVIDER=DEVELOPMENT
OCR_API_ENDPOINT=
OCR_API_KEY=
AI_PROVIDER=DEVELOPMENT
AI_API_ENDPOINT=
AI_API_KEY=
OCR_TIMEOUT_SECONDS=60
OCR_MAX_ATTEMPTS=3
FACT_LOW_CONFIDENCE_THRESHOLD=0.7
OCR_WORKER_CONCURRENCY=2
AI_WORKER_CONCURRENCY=2
MAX_JSON_BODY_SIZE_KB=1024
AUTH_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=30
ANALYSIS_RATE_LIMIT_PER_MINUTE=60
CALCULATION_RATE_LIMIT_PER_MINUTE=60
REVIEW_RATE_LIMIT_PER_MINUTE=120
SECURITY_HEADERS_ENABLED=true
DISTRIBUTED_RATE_LIMIT_ENABLED=false
