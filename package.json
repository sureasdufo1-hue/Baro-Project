{
  "name": "claimlens-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:web": "pnpm --filter @claimlens/web dev",
    "dev:admin": "pnpm --filter @claimlens/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.10.2",
    "@playwright/test": "~1.55.1"
  }
}
